<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Syncomm_Serial_Monitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syncomm_Serial_Monitor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    Title="SyncCOM Serial Monitor">

    <Grid Padding="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
       
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Background="Transparent">
            <NavigationView
                x:Name="NavView"
                PaneDisplayMode="Auto"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                SelectionFollowsFocus="Enabled"
                IsPaneToggleButtonVisible="True"
                OpenPaneLength="300"
                CompactPaneLength="48"
                IsBackEnabled="False"
                PaneTitle="Navigation"
                Background="Transparent"
                
                SelectionChanged="NavView_SelectionChanged"
                BackRequested="NavView_BackRequested">

                <!-- Navigation Menu Items -->
                <NavigationView.MenuItems>
                    <NavigationViewItem Icon="Home" Content="Serial Monitor" Tag="SerialMonitorPage" IsSelected="True"/>
                    <NavigationViewItemSeparator/>
                    <NavigationViewItemHeader Content="Analysis"/>
                    <NavigationViewItem Icon="Globe" Content="Data Visualization" Tag="PlotPage"/>
                    <NavigationViewItem Icon="Document" Content="Data Logs" Tag="LogsPage"/>
                    <NavigationViewItemSeparator/>
                    <NavigationViewItemHeader Content="Appearance"/>
                    <NavigationViewItem>
                        <NavigationViewItem.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;"/>
                                <TextBlock Text="Backdrop Style"/>
                            </StackPanel>
                        </NavigationViewItem.Content>
                        <NavigationViewItem.ContentTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="BackdropStyleComboBox" 
                                          SelectionChanged="BackdropStyleComboBox_SelectionChanged"
                                          Width="auto"
                                          HorizontalContentAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,4">
                                    <ComboBoxItem Content="Mica Alt"/>
                                    <ComboBoxItem Content="Mica Win11"/>
                                    <ComboBoxItem Content="Acrylic Thin"/>
                                    <ComboBoxItem Content="Acrylic Base"/>
                                </ComboBox>
                            </DataTemplate>
                        </NavigationViewItem.ContentTemplate>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <!-- Content Frame -->
                <Grid Background="Transparent">
                    <Frame x:Name="ContentFrame" 
                           Background="Transparent"
                           CornerRadius="16"
                           Margin="16"/>
                </Grid>

            </NavigationView>
        </Grid>
    </Grid>

   
</Window>