<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Syncomm_Serial_Monitor.Views.SerialMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ScottPlot="using:ScottPlot.WinUI"
    xmlns:converters="using:Syncomm_Serial_Monitor.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:StringFormatConverter x:Key="StringFormatConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- InfoBar for notifications -->
        <InfoBar Grid.Row="0" x:Name="StatusInfoBar" 
                 IsOpen="False" 
                 IsClosable="True"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 Margin="0,0,0,10"/>
        
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Visible">
            <StackPanel Spacing="15" HorizontalAlignment="Stretch">

                <!-- Communication Settings Expander -->
                <Expander HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <Grid Padding="10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                     FontFamily="Segoe Fluent Icons"
                                     Glyph="&#xE839;"
                                     Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1"
                                       Orientation="Vertical"
                                       Spacing="2">
                                <TextBlock Text="Communication Display Settings"
                                          Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Configure serial port and display parameters."
                                          Style="{StaticResource CaptionTextBlockStyle}" 
                                          LineStackingStrategy="BaselineToBaseline" 
                                          TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Connection Controls -->
                            <StackPanel Grid.Column="2" Spacing="10" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Port Selection -->
                                <ComboBox MinWidth="100"
                                         HorizontalContentAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         ItemsSource="{Binding SerialPortModel.AvailablePorts}"
                                         SelectedItem="{Binding SerialPortModel.SelectedPort}"/>
                                
                                <!-- Refresh Button -->
                                <Button MinWidth="100"
                                        HorizontalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        Content="Refresh"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding RefreshPortsCommand}"
                                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}"/>
                                
                                <!-- Connection Toggle Button -->
                                <ToggleButton Width="120" 
                                             Height="32"
                                             Command="{Binding ConnectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" 
                                                 FontSize="14"
                                                 Glyph="{Binding ConnectionIcon}"/>
                                        <TextBlock Text="{Binding ConnectionButtonText}" 
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions> 
                            
                            <StackPanel Spacing="10" Grid.Column="0" Orientation="Vertical">
                                <!-- Baud Rate and Data Bits -->
                                <StackPanel HorizontalAlignment="Stretch" Spacing="10" Orientation="Horizontal">
                                    <ComboBox MinWidth="100"
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Header="Baud Rate"
                                             ItemsSource="{Binding SerialPortModel.AvailableBaudRates}"
                                             SelectedItem="{Binding SerialPortModel.BaudRate}"/>

                                    <ComboBox MinWidth="100"
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Header="Data Bits"
                                             ItemsSource="{Binding SerialPortModel.AvailableDataBits}"
                                             SelectedItem="{Binding SerialPortModel.DataBits}"/>
                                </StackPanel>

                                <!-- Data Format -->
                                <RadioButtons MaxColumns="4" 
                                             HorizontalContentAlignment="Stretch" 
                                             HorizontalAlignment="Center" 
                                             Header="Data Format"
                                             SelectedItem="{Binding DataModel.CurrentDataFormat}">
                                    <RadioButton Content="ASCII" IsChecked="True"/>
                                    <RadioButton Content="Hex"/>
                                    <RadioButton Content="Dec"/>
                                    <RadioButton Content="Bin"/>
                                </RadioButtons>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                
                                <ToggleSwitch Grid.Column="0" Grid.Row="1" 
                                             Header="Timestamps" 
                                             IsOn="{Binding DataModel.TimestampEnabled}"/>
                                <ToggleSwitch Grid.Column="0" Grid.Row="0" 
                                             Header="Wrap Text" 
                                             IsOn="{Binding DataModel.WrapTextEnabled}"/>
                                <ToggleSwitch Grid.Column="1" Grid.Row="1" 
                                             Header="Auto-scroll" 
                                             IsOn="{Binding DataModel.AutoScrollEnabled}"/>
                                <ToggleSwitch Grid.Column="1" Grid.Row="0" 
                                             Header="Plot" 
                                             IsOn="{Binding DataModel.ShowPlotEnabled}"/>
                            </Grid>
                        </Grid>
                    </Expander.Content>
                </Expander>

                <!-- Data Display -->
                <Expander HorizontalAlignment="Stretch" IsExpanded="True" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid Padding="5,15" VerticalAlignment="Stretch" ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="Data Display"/>
                                <TextBlock Text="Monitor and analyze received serial data in real-time." 
                                          Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="5" Orientation="Horizontal">
                                <TextBlock Text="Auto scroll" 
                                          HorizontalAlignment="Center" 
                                          HorizontalTextAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                <ToggleSwitch IsOn="{Binding DataModel.AutoScrollEnabled}"
                                             Margin="8,4"/>
                                <NumberBox Header="Row Limit:"
                                          Value="{Binding DataModel.RowLimit}"
                                          SpinButtonPlacementMode="Inline"
                                          SmallChange="10"
                                          LargeChange="50"
                                          Minimum="10"
                                          Maximum="10000"
                                          Width="120"
                                          Margin="8,4"/>
                                <Button Content="Clear"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding ClearDataCommand}"/>
                                <Button Content="Copy"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding CopyDataCommand}"/>
                                <Button Content="Export"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Command="{Binding ExportDataCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid ColumnSpacing="20" RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <!-- Data Display Area -->
                            <Border Grid.Row="0"
                                    CornerRadius="8"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="2*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Data Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>

                                    <!-- Data Display -->
                                    <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                                        <Border HorizontalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Margin="0,0,0,0">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <ScrollViewer Background="Transparent" Grid.Row="0"
                                                             VerticalScrollBarVisibility="Visible"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollMode="Enabled"
                                                             HorizontalScrollMode="Enabled"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch"
                                                             Height="400"
                                                             IsScrollInertiaEnabled="True"
                                                             IsVerticalScrollChainingEnabled="True"
                                                             IsHorizontalScrollChainingEnabled="True"
                                                             ScrollViewer.BringIntoViewOnFocusChange="True">
                                                    <ListView x:Name="DataListView"
                                                              ItemsSource="{Binding DataModel.DataRows}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Top">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" 
                                                                               Text="{Binding Timestamp}" 
                                                                               FontFamily="Consolas"/>
                                                                    <TextBlock Grid.Column="1" 
                                                                               Text="{Binding Data}" 
                                                                               FontFamily="Consolas"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Control Panel -->
                            <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Stretch">
                                <!-- Send Data -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding DataModel.SendText, Mode=TwoWay}"
                                                 PlaceholderText="Enter data to send..."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="auto"
                                                 MaxHeight="100"
                                                 Margin="8,0"/>

                                        <StackPanel Grid.Row="0" Grid.Column="2"
                                                   Orientation="Horizontal"
                                                   Spacing="4"
                                                   VerticalAlignment="Center">
                                            <Button Content="Send"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Command="{Binding SendDataCommand}"/>
                                            <Button Content="Send Hex"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Command="{Binding SendHexDataCommand}"/>
                                        </StackPanel>

                                        <!-- Statistics Section -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Orientation="Horizontal"
                                                   Spacing="12"
                                                   Margin="8,8,0,0">
                                            <TextBlock Text="{Binding SerialPortModel.BytesReceived, Converter={StaticResource StringFormatConverter}, ConverterParameter='Bytes Received: {0:N0}'}"/>
                                            <TextBlock Text="{Binding SerialPortModel.BytesSent, Converter={StaticResource StringFormatConverter}, ConverterParameter='Bytes Sent: {0:N0}'}"/>
                                            <TextBlock Text="{Binding SerialPortModel.ConnectionStatus, Converter={StaticResource StringFormatConverter}, ConverterParameter='Status: {0}'}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Expander.Content>
                </Expander>

                <!-- Plot View -->
                <Expander HorizontalContentAlignment="Stretch" 
                          x:Name="PlotViewExpander" 
                          HorizontalAlignment="Stretch" 
                          IsExpanded="{Binding DataModel.ShowPlotEnabled}">
                    <Expander.Header>
                        <Grid Padding="5,15" VerticalAlignment="Stretch" ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="Plot View"/>
                                <TextBlock Text="Visualize serial data in real-time charts and graphs." 
                                          Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Plot Display Area -->
                            <Border Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Plot Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0"
                                                   Text="Real-time Data Plot"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Export"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Command="{Binding ExportPlotCommand}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Clear"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Command="{Binding ClearPlotCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Plot Area -->
                                    <Border Grid.Row="1" 
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            x:Name="PlotContainer">
                                        <Grid>
                                            <TextBlock Text="Plot area - ScottPlot will be initialized here"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.6"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Plot Controls -->
                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Plot Configuration" 
                                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Data Series" 
                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <ComboBox ItemsSource="{Binding PlotModel.AvailableDataSeries}"
                                                      SelectedItem="{Binding PlotModel.SelectedDataSeries}"/>
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Update Interval (ms)" 
                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <NumberBox Value="{Binding PlotModel.UpdateInterval}" 
                                                       Minimum="50" 
                                                       Maximum="5000"/>
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Export Format" 
                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <ComboBox ItemsSource="{Binding PlotModel.AvailableExportFormats}"
                                                      SelectedItem="{Binding PlotModel.ExportFormat}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Expander.Content>
                </Expander>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page> 