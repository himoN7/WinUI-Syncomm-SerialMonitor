<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Syncomm_Serial_Monitor.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Data Export" 
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Review and modify your data before export" 
                       Style="{StaticResource BodyTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefault}">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DataGrid Header -->
                <Grid Grid.Row="0" 
                      Padding="16,12"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" 
                                  Glyph="&#xE8B7;"
                                  Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="Data Preview" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="RowCountTextBlock" 
                                   Text="(0 rows)"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SelectAllButton"
                                Content="Select All"
                                Click="SelectAllButton_Click"
                                Style="{StaticResource DefaultButtonStyle}"/>
                        <Button x:Name="ClearSelectionButton"
                                Content="Clear Selection"
                                Click="ClearSelectionButton_Click"
                                Style="{StaticResource DefaultButtonStyle}"/>
                        <Button x:Name="RemoveSelectedButton"
                                Content="Remove Selected"
                                Click="RemoveSelectedButton_Click"
                                Style="{StaticResource DefaultButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Data Display -->
                <ListView x:Name="ExportDataGrid"
                          Grid.Row="1"
                          Margin="16"
                          SelectionMode="Multiple">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value1}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value2}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Value3}"/>
                                <TextBlock Grid.Column="4" Text="{Binding Value4}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Value5}"/>
                                <TextBlock Grid.Column="6" Text="{Binding Value6}"/>
                                <TextBlock Grid.Column="7" Text="{Binding Value7}"/>
                                <TextBlock Grid.Column="8" Text="{Binding Value8}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Export Controls -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Spacing="12"
                    Margin="0,20,0,0">
            
            <ComboBox x:Name="ExportFormatComboBox"
                      Header="Export Format"
                      Width="150"
                      SelectedIndex="0">
                <ComboBoxItem Content="CSV"/>
                <ComboBoxItem Content="JSON"/>
                <ComboBoxItem Content="XML"/>
            </ComboBox>

            <Button x:Name="ExportButton"
                    Content="Export Data"
                    Click="ExportButton_Click"
                    Style="{StaticResource AccentButtonStyle}"/>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Style="{StaticResource DefaultButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page> 