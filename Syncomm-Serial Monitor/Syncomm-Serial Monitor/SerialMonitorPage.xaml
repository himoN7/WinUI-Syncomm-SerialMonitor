<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Syncomm_Serial_Monitor.SerialMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ScottPlot="using:ScottPlot.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- InfoBar for notifications -->
        <InfoBar Grid.Row="0" x:Name="StatusInfoBar" 
                 IsOpen="False" 
                 IsClosable="True"
                                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 Margin="0,0,0,10"/>
        
        <ScrollView Grid.Row="1"  VerticalScrollBarVisibility="Visible">
            <StackPanel Spacing="15" HorizontalAlignment="Stretch">

                <!--Uniformed expander-->
                <!-- Fluent Compact Expander -->
                <Expander HorizontalContentAlignment="Stretch"  HorizontalAlignment="Stretch">
                    <!-- Header -->
                    <Expander.Header>
                        <Grid Padding="10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
   FontFamily="Segoe Fluent Icons"
   Glyph="&#xE839;"
   Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1"
     Orientation="Vertical"
     Spacing="2">
                                <TextBlock Text="Communication Display Settings"
        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Configure serial port and display parameters."
        Style="{StaticResource CaptionTextBlockStyle}" LineStackingStrategy="BaselineToBaseline" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!--Connect Toggle Button-->
                            <StackPanel Grid.Column="2" Spacing="10" Orientation="Horizontal" VerticalAlignment="Center">
                               

                                <!-- Port -->
                                <ComboBox
                                          MinWidth="100"
                                          HorizontalContentAlignment="Stretch"
                                                HorizontalAlignment="Stretch"
                                    
                                               VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" x:Name="PortComboBox"/>
                                <!-- Refresh -->

                                <Button x:Name="RefreshPortsButton" MinWidth="100"
HorizontalContentAlignment="Center"
      HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="2" Content="Refresh" Style="{StaticResource DefaultButtonStyle}" Click="RefreshPortsButton_Click"/>
                                
                                <!-- Connection Toggle Button -->
                                <ToggleButton x:Name="ConnectionToggleButton" 
                                             Width="120" 
                                             Height="32"
                                             Click="ConnectionToggleButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon x:Name="ConnectionIcon" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                        <TextBlock x:Name="ConnectionText" Text="Connect" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <!--Port-->
                       
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>

                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions> 
                            
                            
                            <StackPanel Spacing="10" Grid.Column="0"   Orientation="Vertical">

                                    <!--Row1--> 
                                    <StackPanel HorizontalAlignment="Stretch" Spacing="10" Orientation="Horizontal">

                                     

                                        <!--Port Setting-->
                                        <StackPanel Spacing="5" Orientation="Horizontal">
                                              <!-- Baud Rate -->
                                        <ComboBox   MinWidth="100"
  HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch" Header="Baud Rate" Grid.Row="1" Grid.Column="1" x:Name="BaudRateComboBox"/>

                                          <!-- Data Bits -->

                                        <ComboBox   MinWidth="100"
  HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch" Header="Data Bits" Grid.Row="1" Grid.Column="3" x:Name="DataBitsComboBox"/>
                           
                                        </StackPanel>

                                       


                                    </StackPanel>
<!--Row 2-->
                                    <StackPanel HorizontalAlignment="Stretch" Spacing="10" Orientation="Horizontal">
                                          
                                <RadioButtons MaxColumns="4" HorizontalContentAlignment="Stretch" HorizontalAlignment="Center" Header="Data Format" SelectionChanged="DataFormat_SelectionChanged">
                                    <RadioButton  Content="ASCII" IsChecked="True"/>
                                    <RadioButton Content="Hex"/>
                                    <RadioButton Content="Dec"/>
                                    <RadioButton Content="Bin"/>
                                </RadioButtons>
                                        
                                        
                                    </StackPanel>
                                    
                                        
                                    
                                    </StackPanel>

                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <ToggleSwitch OnContent="" OffContent="" Grid.Column="0" Grid.Row="1" x:Name="TimestampToggle" Header="Timestamps" IsOn="True" Toggled="TimestampToggle_Toggled"/>
                                <ToggleSwitch OnContent="" OffContent="" Grid.Column="0" Grid.Row="0" x:Name="WrapTextToggle" Header="Wrap Text" Toggled="WrapTextToggle_Toggled"/>
                                <ToggleSwitch OnContent="" OffContent="" Grid.Column="1" Grid.Row="1" x:Name="AutoScrollToggle" Header="Auto-scroll" IsOn="True" Toggled="AutoScrollToggle_Toggled"/>
                                <ToggleSwitch OnContent="" OffContent=""  Grid.Column="1" Grid.Row="0" Header="Plot" x:Name="ShowPlotToggle" IsOn="False" Toggled="ShowPlotToggle_Toggled"/>
                            </Grid>


                        </Grid>
                            
                    </Expander.Content>
                </Expander>



                <!-- Data Display -->
                <Expander HorizontalAlignment="Stretch" IsExpanded="True" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid Padding="5,15" VerticalAlignment="Stretch" ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE8B5;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="Data Display"/>
                                <TextBlock Text="Monitor and analyze received serial data in real-time." Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>

                         
                             

                                <StackPanel Grid.Column="2" Spacing="5" Orientation="Horizontal">
                                <TextBlock Visibility="Collapsed" Text="Auto scroll" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleSwitch Visibility="Collapsed" x:Name="DataGridAutoScrollToggle"
                           
                              IsOn="True"
                              Margin="8,4"/>
                                    <CheckBox Visibility="Collapsed"
 x:Name="DataGridEnabled" 
 Content="Enable DataGrid" 
 IsChecked="True" 
 Margin="8,4"/>

                                <Button Height="40" x:Name="ClearDataButton"
                     Content="Clear"
                     Style="{StaticResource DefaultButtonStyle}"
                                 Click="ClearDataButton_Click"
                    />
                                <Button Height="40"  x:Name="CopyDataButton"
                                 Content="Copy"
                     Style="{StaticResource DefaultButtonStyle}"
                                 Click="CopyDataButton_Click"/>
                                <Button Height="40" x:Name="ExportDataButton"
                                 Content="Export"
                     Style="{StaticResource DefaultButtonStyle}"
                                 Click="ExportDataButton_Click"/>
                                </StackPanel>
        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid ColumnSpacing="20" RowSpacing="20">
            <Grid.ColumnDefinitions>
            
            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <!-- Data Display Area -->
                            <Border  Grid.Column="0" Grid.Row="0"
                                 
                       
                        CornerRadius="8"
                                    Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <!-- Data Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                          
                        </Grid>

                                    <!-- Data Display Comparison -->
                        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
                                        <Border  HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Margin="0,0,0,0">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <ScrollViewer Background="Transparent" Grid.Row="0"
                                                             VerticalScrollBarVisibility="Visible"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             VerticalScrollMode="Enabled"
                                                             HorizontalScrollMode="Enabled"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch"
                                                             Height="450"
                                                             IsScrollInertiaEnabled="True"
                                                             IsVerticalScrollChainingEnabled="True"
                                                             IsHorizontalScrollChainingEnabled="True"
                                                             ScrollViewer.BringIntoViewOnFocusChange="True"
                                                             ViewChanged="DataGridScrollViewer_ViewChanged"
                                                             x:Name="DataGridScrollViewer">
                                                    <Grid x:Name="DataDataGrid"
                                                          
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Top">
                                                        <!-- Grid content will be populated dynamically -->
                                                    </Grid>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>

                    </Grid>
                </Border>

                            <!-- Control Panel -->
                       
                                 <StackPanel Grid.Row="1"  Spacing="12" HorizontalAlignment="Stretch">
                                <!-- Send Data -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                      

                                        <TextBox Grid.Row="0" Grid.Column="1"
             x:Name="SendTextBox"
             PlaceholderText="Enter data to send..."
             AcceptsReturn="True"
             TextWrapping="Wrap"
             Height="auto"
                                                 MaxHeight="100"
             KeyDown="SendTextBox_KeyDown"
             Margin="8,0"/>

                                        <StackPanel Grid.Row="0" Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
                                            <Button x:Name="SendButton"
                Content="Send"
                Style="{StaticResource AccentButtonStyle}"
                Click="SendButton_Click"/>
                                            <Button x:Name="SendHexButton"
                Content="Send Hex"
                Style="{StaticResource DefaultButtonStyle}"
                Click="SendHexButton_Click"/>
                                        </StackPanel>

                                        <!-- Statistics Section -->
                                       

                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                Orientation="Horizontal"
                Spacing="12"
                Margin="8,8,0,0">
                                            <TextBlock x:Name="BytesReceivedText" Text="Bytes Received: 0"/>
                                            <TextBlock x:Name="BytesSentText" Text="Bytes Sent: 0"/>
                                            <TextBlock x:Name="ConnectionStatusText" Text="Status: Disconnected"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                              
                            </StackPanel>
                          
                           
                        </Grid>
                    </Expander.Content>
                </Expander>

                <!-- Plot View -->
                <Expander HorizontalContentAlignment="Stretch" x:Name="PlotViewExpander" HorizontalAlignment="Stretch" IsExpanded="False">
                    <Expander.Header>
                        <Grid Padding="5,15" VerticalAlignment="Stretch" ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="0">
                                <TextBlock Text="Plot View"/>
                                <TextBlock Text="Visualize serial data in real-time charts and graphs." Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Plot Display Area -->
                            <Border Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8"
                                    Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                                    <!-- Plot Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0"
                                     Text="Real-time Data Plot"
                                     Style="{StaticResource SubtitleTextBlockStyle}"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="ExportPlotButton"
                                                    Content="Export"
                                                    Style="{StaticResource DefaultButtonStyle}"
                                                    Click="ExportPlotButton_Click"
                                                    Margin="0,0,8,0"/>
                                <Button x:Name="ClearPlotButton"
                                                    Content="Clear"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Click="ClearPlotButton_Click"/>
                            </StackPanel>
                        </Grid>

                                    <!-- Plot Area -->
                                    <Border Grid.Row="1" 
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            x:Name="PlotContainer">
                                        <Grid>
                                            <TextBlock Text="Plot area - ScottPlot will be initialized here"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Opacity="0.6"/>
                    </Grid>
                </Border>
            </Grid>
                            </Border>

                            <!-- Plot Controls -->
                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                              BorderThickness="1"
                              CornerRadius="8"
                                        Padding="16">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Plot Configuration" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Data Series" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <ComboBox x:Name="DataSeriesComboBox" PlaceholderText="Select data series">
                                                <ComboBoxItem Content="All Data"/>
                                                <ComboBoxItem Content="Received Data"/>
                                                <ComboBoxItem Content="Sent Data"/>
                                            </ComboBox>
                            </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Update Interval (ms)" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            
                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Export Format" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <ComboBox x:Name="ExportFormatComboBox">
                                                <ComboBoxItem Content="PNG" IsSelected="True"/>
                                                <ComboBoxItem Content="JPG"/>
                                                <ComboBoxItem Content="SVG"/>
                                </ComboBox>
                            </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Zoom Controls" Style="{StaticResource CaptionTextBlockStyle}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="ZoomInButton" Content="Zoom In" Style="{StaticResource DefaultButtonStyle}" Click="ZoomInButton_Click"/>
                                                <Button x:Name="ZoomOutButton" Content="Zoom Out" Style="{StaticResource DefaultButtonStyle}" Click="ZoomOutButton_Click"/>
                                                <Button x:Name="ResetZoomButton" Content="Reset" Style="{StaticResource DefaultButtonStyle}" Click="ResetZoomButton_Click"/>
                                            </StackPanel>
                            </StackPanel>
                            </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Expander.Content>
                    </Expander>
                            </StackPanel>
        </ScrollView>
    </Grid>
</Page> 